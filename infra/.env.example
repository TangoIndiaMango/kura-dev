# Copy to infra/.env for docker compose
# Local dev uses config.settings.local (DEBUG on: test OTP 123456, demo wallet
# credit, mock IoT telemetry). A real server MUST set:
#   DJANGO_SETTINGS_MODULE=config.settings.prod   (or .staging)
#   DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, CORS_ORIGINS, REDIS_URL,
#   EMAIL_ENABLED=true + EMAIL_HOST, PAYSTACK_SECRET_KEY
# Prod settings print a [kura config] WARNING at boot for each one missing.
# CRON_SECRET only if you trigger jobs over HTTP instead of `run_task_worker`.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

POSTGRES_DB=kura
POSTGRES_USER=kura
POSTGRES_PASSWORD=kura_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8001
CADDY_HTTP_PORT=8080

# Host-run Django (`just migrate` / `just backend`) → compose db/redis on localhost.
# Docker api service overrides DATABASE_URL to use host `db` instead of 127.0.0.1.
DATABASE_URL=postgres://kura:kura_dev_password@127.0.0.1:5432/kura
REDIS_URL=redis://127.0.0.1:6379/0

CORS_ORIGINS=http://localhost:5175,http://localhost:5176,http://127.0.0.1:5175,http://127.0.0.1:5176
JWT_SIGNING_KEY=

# Media — provider-neutral assets; Cloudinary is the current adapter
MEDIA_PROVIDER=cloudinary
MEDIA_STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=uploads

# Paystack (wallet funding via dedicated NUBAN)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PSP customers need an email; phone-only riders get acct-<id>@this-domain
PSP_CUSTOMER_EMAIL_DOMAIN=customers.kura.eco
# Dedicated virtual accounts (individual DVAs need extra Paystack KYC). Off: riders pay
# each swap with Paystack Checkout (POST /api/v1/mobility/swaps/{id}/checkout/).
PSP_VIRTUAL_ACCOUNTS_ENABLED=false
# Fake telemetry ticks — never on a real server
MOCK_IOT_ENABLED=

# Hourly jobs — cron-job.org / compose worker POST with this header
# curl -X POST -H "X-Cron-Secret: $CRON_SECRET" https://api…/api/v1/internal/jobs/flag-unreturned/
CRON_SECRET=change-me-cron-local-dev

# Email — leave EMAIL_HOST empty for console backend in local dev
EMAIL_ENABLED=false
EMAIL_FAIL_SILENTLY=true
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=KURA <noreply@kura.eco>
DEFAULT_REPLY_TO=
KURA_SUPPORT_EMAIL=
FRONTEND_CLIENT_URL=http://localhost:5175
FRONTEND_ADMIN_URL=http://localhost:5176
EMAIL_LOG_OTP_IN_DEV=true

# Kura production settings (copy to production.env; never commit that file).
# Secrets: long random strings (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))").
KURA_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
OTP_PEPPER=
QR_HMAC_PEPPER=
RECEIPT_SIGNING_SECRET=
CRON_SECRET=

DJANGO_ALLOWED_HOSTS=api.kuramobility.com
CORS_ORIGINS=https://admin.kuramobility.com,https://kuramobility.com
FRONTEND_ADMIN_URL=https://admin.kuramobility.com
FRONTEND_CLIENT_URL=https://kuramobility.com

# database (the compose file builds DATABASE_URL / REDIS_URL from these)
POSTGRES_DB=kura
POSTGRES_USER=kura
POSTGRES_PASSWORD=

# payments
DEFAULT_PSP=PAYSTACK
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PSP_VIRTUAL_ACCOUNTS_ENABLED=false

# media
MEDIA_PROVIDER=cloudinary
MEDIA_STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# email (sign-in codes, password resets)
EMAIL_ENABLED=true
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=
DEFAULT_REPLY_TO=
KURA_SUPPORT_EMAIL=
PASSWORD_RESET_TIMEOUT_MINUTES=

KURA_BANK_NAME=
KURA_BANK_ACCOUNT_NAME=
KURA_BANK_ACCOUNT_NUMBER=
